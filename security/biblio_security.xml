<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_biblio" model="ir.module.category">
        <field name="name">Bibliothèque</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_biblio_lecteur" model="res.groups">
        <field name="name">Lecteur</field>
        <field name="category_id" ref="module_category_biblio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_biblio_bibliothecaire" model="res.groups">
        <field name="name">Bibliothécaire</field>
        <field name="category_id" ref="module_category_biblio"/>
        <field name="implied_ids" eval="[(4, ref('group_biblio_lecteur'))]"/>
    </record>

    <record id="rule_biblio_emprunt_lecteur" model="ir.rule">
        <field name="name">Lecteur : lecture des emprunts</field>
        <field name="model_id" ref="model_biblio_emprunt"/>
        <field name="domain_force">[('id', '>', 0)]</field>
        <field name="groups" eval="[(4, ref('group_biblio_lecteur'))]"/>
    </record>

    <record id="rule_biblio_emprunt_bibliothecaire" model="ir.rule">
        <field name="name">Bibliothécaire : gestion des emprunts</field>
        <field name="model_id" ref="model_biblio_emprunt"/>
        <field name="domain_force">[('id', '>', 0)]</field>
        <field name="groups" eval="[(4, ref('group_biblio_bibliothecaire'))]"/>
    </record>

    <!-- L'administrateur reçoit le rôle Bibliothécaire -->
    <record id="base.user_admin" model="res.users">
        <field name="groups_id" eval="[(4, ref('group_biblio_bibliothecaire'))]"/>
    </record>

</odoo>