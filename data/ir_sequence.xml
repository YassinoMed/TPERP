<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="sequence_biblio_emprunt" model="ir.sequence">
            <field name="name">Emprunts</field>
            <field name="code">biblio.emprunt</field>
            <field name="prefix">EMP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range">False</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="sequence_biblio_carte" model="ir.sequence">
            <field name="name">Cartes de membre</field>
            <field name="code">biblio.carte</field>
            <field name="prefix">MBR/</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="implementation">no_gap</field>
            <field name="use_date_range">False</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
