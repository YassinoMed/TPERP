<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="cron_biblio_emprunt_retards" model="ir.cron">
        <field name="name">Bibliothèque : détecter les emprunts en retard</field>
        <field name="model_id" ref="model_biblio_emprunt"/>
        <field name="state">code</field>
        <field name="code">model._mark_overdue_emprunts()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
        <field name="active" eval="True"/>
    </record>

</odoo>
